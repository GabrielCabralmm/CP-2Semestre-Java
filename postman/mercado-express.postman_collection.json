{
  "info": {
    "name": "Mercado Express - Checkpoint 4",
    "description": "Testes CRUD para a API Mercado Express (FIAP - CP4 Parte 1). Use a variável {{base_url}} para trocar facilmente entre localhost e o link do deploy.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8082"
    },
    {
      "key": "mercado_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1 - CREATE - Criar produto",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Detergente Neutro 500ml\",\n  \"tipo\": \"Limpeza\",\n  \"setor\": \"Higiene\",\n  \"tamanho\": \"500ml\",\n  \"preco\": 3.99\n}"
        },
        "url": {
          "raw": "{{base_url}}/mercado",
          "host": ["{{base_url}}"],
          "path": ["mercado"]
        },
        "description": "Cria um novo produto. Copie o 'id' retornado e atualize a variável mercado_id para os próximos testes."
      }
    },
    {
      "name": "2 - READ - Listar todos os produtos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/mercado",
          "host": ["{{base_url}}"],
          "path": ["mercado"]
        },
        "description": "Lista todos os produtos cadastrados, no formato HATEOAS (_embedded / _links)."
      }
    },
    {
      "name": "3 - READ - Buscar produto por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/mercado/{{mercado_id}}",
          "host": ["{{base_url}}"],
          "path": ["mercado", "{{mercado_id}}"]
        },
        "description": "Busca um produto específico pelo ID."
      }
    },
    {
      "name": "4 - UPDATE (completo) - PUT",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Detergente Neutro 1L\",\n  \"tipo\": \"Limpeza\",\n  \"setor\": \"Higiene\",\n  \"tamanho\": \"1L\",\n  \"preco\": 6.49\n}"
        },
        "url": {
          "raw": "{{base_url}}/mercado/{{mercado_id}}",
          "host": ["{{base_url}}"],
          "path": ["mercado", "{{mercado_id}}"]
        },
        "description": "Atualiza TODOS os campos do produto (substitui o registro por completo)."
      }
    },
    {
      "name": "5 - UPDATE (parcial) - PATCH",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"preco\": 5.99\n}"
        },
        "url": {
          "raw": "{{base_url}}/mercado/{{mercado_id}}",
          "host": ["{{base_url}}"],
          "path": ["mercado", "{{mercado_id}}"]
        },
        "description": "Atualiza apenas o(s) campo(s) enviado(s), mantendo os demais como estavam."
      }
    },
    {
      "name": "6 - DELETE - Remover produto",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/mercado/{{mercado_id}}",
          "host": ["{{base_url}}"],
          "path": ["mercado", "{{mercado_id}}"]
        },
        "description": "Remove o produto do banco pelo ID. Resposta esperada: 204 No Content."
      }
    },
    {
      "name": "7 - READ - Buscar ID inexistente (teste de erro 404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/mercado/99999",
          "host": ["{{base_url}}"],
          "path": ["mercado", "99999"]
        },
        "description": "Testa o tratamento de erro: deve retornar 404 com a mensagem 'Produto nao encontrado para o id: 99999'."
      }
    }
  ]
}
